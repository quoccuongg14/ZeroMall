datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Voucher {
  id           String              @id @default(uuid())
  shopId       String
  name         String
  code         String
  type         String // "percentage" | "fixed"
  value        Float
  minSpend     Float
  maxDiscount  Float?
  usageLimit   Int
  usedCount    Int                 @default(0)
  targetUserId String? // ID của user được cấp riêng (Goodwill Compensation Voucher CSKH)
  isClaimable  Boolean             @default(false) // Voucher khung giờ vàng cần bấm Lưu vào ví (Claimable)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  usages       VoucherUsage[]
  claims       UserVoucherWallet[]

  @@unique([shopId, code])
}

model VoucherUsage {
  id        String   @id @default(uuid())
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId    String
  orderId   String?
  usedAt    DateTime @default(now())

  @@index([voucherId, userId])
  @@index([userId])
}

model UserVoucherWallet {
  id        String   @id @default(uuid())
  userId    String
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  claimedAt DateTime @default(now())

  @@unique([userId, voucherId])
  @@index([userId])
}
