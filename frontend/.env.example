# Frontend Environment Variables
# Copy file này thành .env (local) hoặc cấu hình trên Vercel Project Settings -> Environment Variables

# Backend API Gateway & Services (Bắt buộc dùng HTTPS khi deploy Vercel)
VITE_API_URL=http://localhost:8000
VITE_TRYON_SERVICE_URL=http://localhost:5006
# Tùy chọn: ghi đè URL WebSocket chat nếu không đi qua Kong
# VITE_CHAT_SOCKET_URL=https://api.zeromall.id.vn/chat

# Third-party integrations
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
VITE_CLOUDINARY_UPLOAD_PRESET=zeromall_unsigned
VITE_GOONG_API_KEY=your_goong_api_key_here
# Tùy chọn: Supabase Storage
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

